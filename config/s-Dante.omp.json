{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "background": "#7F8DD3",
          "foreground": "#FAF9F5",
          "template": " {{ if .WSL }}WSL ({{ .Icon }}){{ else }}{{ .Icon }}{{ end }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#A493CB",
          "foreground": "#FAF9F5",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#C998C2",
          "foreground": "#FAF9F5",
          "properties": {
            "style": "folder"
          },
          "template": " \ue5ff {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#DA9784",
          "foreground": "#FAF9F5",
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }} \uf040 {{ end }}{{ if .Staging.Changed }} \uf044 {{ end }} "
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#7F8DD3",
          "foreground": "#FAF9F5",
          "properties": {
            "precision": 0
          },
          "template": " \uf85a {{ round .PhysicalMemoryPercentUsed .Precision }}% "
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#A493CB",
          "foreground": "#FAF9F5",
          "properties": {
            "precision": 0
          },
          "template": " \uf4bc {{ round .CPUPercent .Precision }}% "
        },
        {
          "type": "battery",
          "style": "diamond",
          "trailing_diamond": "\ue0b4",
          "background": "#1E1E1E",
          "foreground": "#FAF9F5",
          "properties": {
            "charged_icon": "\uf58e ",
            "charging_icon": "\uf583 ",
            "discharging_icon": "\uf578 "
          },
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}%{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#DA9784",
          "template": "\u276f"
        }
      ]
    }
  ]
}
